@page "/donors"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using AzilEdu.Shared.DTOs
@inject HttpClient Http

<MudText Typo="Typo.h4" GutterBottom="true">Donatori</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Donatori dolaze iz baze preko API projekta. Tip i status čitaju se iz povezanih lookup tablica.
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="searchString"
                          Label="Pretraži donatore"
                          Placeholder="Ime, prezime, organizacija ili grad"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Status"
                       @bind-Value="selectedStatus"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var status in statusList)
                {
                    <MudSelectItem Value="@status.Name">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetFilters">
                Očisti
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="@donors" Filter="FilterDonors" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.LastName)">Prezime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.FirstName)">Ime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.OrganizationName)">Organizacija</MudTableSortLabel></MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Grad</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.Type)">Tip</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Prezime">@context.LastName</MudTd>
        <MudTd DataLabel="Ime">@context.FirstName</MudTd>
        <MudTd DataLabel="Organizacija">@context.OrganizationName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Grad">@context.City</MudTd>
        <MudTd DataLabel="Tip">@context.Type</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetStatusColor(context.Status)"
                     Variant="Variant.Filled">
                @context.Status
            </MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            Nema rezultata za zadane kriterije pretrage i filtera.
        </MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<DonorDto> donors = new();
    private List<LookupDto> statusList = new();

    private string searchString = string.Empty;
    private string? selectedStatus;

    protected override async Task OnInitializedAsync()
    {
        donors = await Http.GetFromJsonAsync<List<DonorDto>>("api/donors") ?? new();
        statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/donorstatuses") ?? new();
    }

    private void ResetFilters()
    {
        searchString = string.Empty;
        selectedStatus = null;
    }

    private bool FilterDonors(DonorDto donor)
    {
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var term = searchString.Trim().ToLower();

            var matchesSearch =
                (!string.IsNullOrWhiteSpace(donor.FirstName) && donor.FirstName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(donor.LastName) && donor.LastName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(donor.OrganizationName) && donor.OrganizationName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(donor.City) && donor.City.ToLower().Contains(term));

            if (!matchesSearch)
                return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus) &&
            !string.Equals(donor.Status, selectedStatus, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Novi" => Color.Info,
            "Aktivan" => Color.Success,
            "Povremeni" => Color.Warning,
            "Neaktivan" => Color.Default,
            _ => Color.Default
        };
    }
}
