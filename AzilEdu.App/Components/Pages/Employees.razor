@page "/employees"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using AzilEdu.Shared.DTOs
@inject HttpClient Http

<MudText Typo="Typo.h4" GutterBottom="true">Djelatnici</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Djelatnici dolaze iz baze preko API projekta. Pozicija i status čitaju se iz povezanih lookup tablica.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="searchString"
                          Label="Pretraži djelatnike"
                          Placeholder="Ime, prezime, email ili oznaka"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Status"
                       @bind-Value="selectedStatus"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var status in statusList)
                {
                    <MudSelectItem Value="@status.Name">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetFilters">
                Očisti
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <MudPaper Class="pa-8 d-flex justify-center" Elevation="0">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudPaper>
}
else
{
<MudTable Items="@employees" Filter="FilterEmployees" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeDto, object>(x => x.LastName)">Prezime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeDto, object>(x => x.FirstName)">Ime</MudTableSortLabel></MudTh>
        <MudTh>Oznaka</MudTh>
        <MudTh>Email</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeDto, object>(x => x.HireDate ?? DateTime.MaxValue)">Datum zaposlenja</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeDto, object>(x => x.Position)">Pozicija</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<EmployeeDto, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Prezime">@context.LastName</MudTd>
        <MudTd DataLabel="Ime">@context.FirstName</MudTd>
        <MudTd DataLabel="Oznaka">@context.EmployeeNumber</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Datum zaposlenja">@GetHireDateText(context)</MudTd>
        <MudTd DataLabel="Pozicija">@context.Position</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetStatusColor(context.Status)"
                     Variant="Variant.Filled">
                @context.Status
            </MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            @(employees.Count == 0
                ? "Još nema unesenih djelatnika."
                : "Nema rezultata za zadane kriterije pretrage i filtera.")
        </MudText>
    </NoRecordsContent>
</MudTable>
}

@code {
    private List<EmployeeDto> employees = new();
    private List<LookupDto> statusList = new();
    private bool isLoading = true;
    private string? errorMessage;

    private string searchString = string.Empty;
    private string? selectedStatus;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            employees = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees") ?? new();
            statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/employeestatuses") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Djelatnike nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFilters()
    {
        searchString = string.Empty;
        selectedStatus = null;
    }

    private bool FilterEmployees(EmployeeDto employee)
    {
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var term = searchString.Trim().ToLower();

            var matchesSearch =
                (!string.IsNullOrWhiteSpace(employee.FirstName) && employee.FirstName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(employee.LastName) && employee.LastName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(employee.Email) && employee.Email.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(employee.EmployeeNumber) && employee.EmployeeNumber.ToLower().Contains(term));

            if (!matchesSearch)
                return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus) &&
            !string.Equals(employee.Status, selectedStatus, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private string GetHireDateText(EmployeeDto employee)
    {
        return employee.HireDate.HasValue
            ? employee.HireDate.Value.ToShortDateString()
            : "Nepoznato";
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Aktivan" => Color.Success,
            "Na dopustu ili bolovanju" => Color.Warning,
            "Neaktivan" => Color.Default,
            _ => Color.Default
        };
    }
}
