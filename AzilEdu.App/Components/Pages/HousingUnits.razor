@page "/housing-units"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Smještajne jedinice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Smještajne jedinice</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Ovdje se prikazuje pregled boksova, soba i drugih prostora u kojima se životinje
    trenutačno nalaze u azilu, zajedno s popunjenošću i statusom svake jedinice.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupno jedinica</MudText>
            <MudText Typo="Typo.h5">@TotalUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Aktivnih jedinica</MudText>
            <MudText Typo="Typo.h5">@ActiveUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Punih jedinica</MudText>
            <MudText Typo="Typo.h5">@FullUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="3">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Slobodan kapacitet</MudText>
            <MudText Typo="Typo.h5">@TotalFreeCapacity</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="@ShowAllUnits">Sve</MudButton>
    <MudButton OnClick="@ShowActiveUnits">Aktivne</MudButton>
    <MudButton OnClick="@ShowFullUnits">Pune</MudButton>
    <MudButton OnClick="@ShowFreeUnits">Slobodno</MudButton>
</MudButtonGroup>

<MudButton Variant = "Variant.Filled" Color = "Color.Primary" Href = "/housingUnits/create" Class = "mb-4">
    Novi smještaj
</MudButton>

@if (isLoading)
{
    <MudPaper Class="pa-8 d-flex justify-center" Elevation="0">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudPaper>
}
else
{
<MudTable Items="@FilteredHousingUnits" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Akcije</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@GetImageUrl(context)" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Naziv">@context.Name</MudTd>
        <MudTd DataLabel="Tip">@context.UnitType</MudTd>
        <MudTd DataLabel="Kapacitet">@context.Capacity</MudTd>
        <MudTd DataLabel="Zauzeto">@context.Occupied</MudTd>
        <MudTd DataLabel="Slobodno">@GetFreeCapacity(context)</MudTd>
        <MudTd DataLabel="Zadnje čišćenje">@GetCleaningDateText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetUnitStatusColor(context)"
                     Variant="Variant.Filled">
                @GetUnitStatusText(context)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Akcije">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/housingUnits/edit/{context.Id}")">
                Uredi
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteHousingUnit(context))">
                Obriši
            </MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            @(housingUnits.Count == 0
                ? "Još nema unesenih smještajnih jedinica."
                : "Nema jedinica za odabrani filter.")
        </MudText>
    </NoRecordsContent>
</MudTable>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await Http.GetFromJsonAsync<List<HousingUnitDto>>("api/housingunits");
            housingUnits = result ?? new List<HousingUnitDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Smještajne jedinice nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string selectedHousingFilter = "Sve";

    private List<HousingUnitDto> housingUnits = new();
    private bool isLoading = true;
    private string? errorMessage;

    private int TotalUnits => housingUnits.Count;

    private int ActiveUnits => housingUnits.Count(unit => unit.IsActive);

    private int FullUnits => housingUnits.Count(unit => unit.IsActive && IsFull(unit));

    private int TotalFreeCapacity => housingUnits.Where(unit => unit.IsActive).Sum(unit => GetFreeCapacity(unit));

    private IEnumerable<HousingUnitDto> FilteredHousingUnits =>
        selectedHousingFilter switch
        {
            "Aktivne" => housingUnits.Where(unit => unit.IsActive),
            "Pune" => housingUnits.Where(unit => unit.IsActive && IsFull(unit)),
            "Slobodno" => housingUnits.Where(unit => unit.IsActive && !IsFull(unit)),
            _ => housingUnits
        };

    private void ShowAllUnits()
    {
        selectedHousingFilter = "Sve";
    }

    private void ShowActiveUnits()
    {
        selectedHousingFilter = "Aktivne";
    }

    private void ShowFullUnits()
    {
        selectedHousingFilter = "Pune";
    }

    private void ShowFreeUnits()
    {
        selectedHousingFilter = "Slobodno";
    }

    private static string GetImageUrl(HousingUnitDto unit)
    {
        return string.IsNullOrWhiteSpace(unit.ImageUrl)
            ? "/images/housing-units/placeholder.svg"
            : unit.ImageUrl;
    }

    private bool IsFull(HousingUnitDto unit)
    {
        return unit.Occupied >= unit.Capacity;
    }

    private int GetFreeCapacity(HousingUnitDto unit)
    {
        return Math.Max(0, unit.Capacity - unit.Occupied);
    }

    private string GetCleaningDateText(HousingUnitDto unit)
    {
        if (unit.LastCleanedAt.HasValue)
        {
            return unit.LastCleanedAt.Value.ToShortDateString();
        }

        return "Nije uneseno";
    }

    private string GetUnitStatusText(HousingUnitDto unit)
    {
        if (!unit.IsActive)
        {
            return "Neaktivno";
        }

        if (IsFull(unit))
        {
            return "Puno";
        }

        return "Slobodno";
    }

    private Color GetUnitStatusColor(HousingUnitDto unit)
    {
        if (!unit.IsActive)
        {
            return Color.Default;
        }

        if (IsFull(unit))
        {
            return Color.Error;
        }

        return Color.Success;
    }

    private async Task DeleteHousingUnit(HousingUnitDto unit)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            title: "Brisanje smještajne jedinice",
            message: $"Smještajna jedinica \"{unit.Name}\" bit će trajno obrisana. Želiš li nastaviti?",
            yesText: "Obriši",
            cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        errorMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"api/housingUnits/{unit.Id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Smještajnu jedinicu nije moguće obrisati.";
                return;
            }

            housingUnits = housingUnits.Where(h => h.Id != unit.Id).ToList();

            Snackbar.Add("Smještajna jedinica je obrisana.", Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod brisanja smještajne jedinice: {ex.Message}";
        }
    }
}
