@page "/housingUnits/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">
    Uredi smještajnu jedinicu
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

@if (isLoading)
{
    <MudPaper Class="pa-8 d-flex justify-center" Elevation="0">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudPaper>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Warning">
        Tražena smještajna jedinica nije pronađena.
    </MudAlert>
}
else
{
    <EditForm Model="model" OnValidSubmit="UpdateHousingUnit" FormName="housing-unit-edit">
        <DataAnnotationsValidator />

        <MudStack Spacing="2">
            <MudTextField @bind-Value="model.Name" Label="Ime" Required="true"
                          For="@(() => model.Name)" />
            <MudTextField @bind-Value="model.UnitType" Label="Tip smještaja" Required="true"
                          For="@(() => model.UnitType)" />
            <MudNumericField @bind-Value="model.Capacity" Label="Kapacitet"
                             For="@(() => model.Capacity)" />
            <MudNumericField @bind-Value="model.Occupied" Label="Zauzeto"
                             For="@(() => model.Occupied)" />
            <MudDatePicker @bind-Date="lastCleanedAt" Label="Zadnje čišćenje" />
            <MudCheckBox @bind-Value="model.IsActive" Label="Aktivno" />
            <MudTextField @bind-Value="model.ImageUrl" Label="Url Slike"
                          For="@(() => model.ImageUrl)" />
            <MudTextField @bind-Value="model.Note" Label="Dodatno" Lines="3"
                          For="@(() => model.Note)" />

            <MudStack Row="true">
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Spremam..." : "Spremi promjene")
                </MudButton>
                <MudButton Variant="Variant.Text" Href="/housing-units" Disabled="isSaving">
                    Odustani
                </MudButton>
            </MudStack>
        </MudStack>
    </EditForm>
}

@code
{
    [Parameter] public int Id { get; set; }

    private SaveHousingUnitDto model = new();
    private DateTime? lastCleanedAt;

    private bool isLoading = true;
    private bool isSaving;
    private bool notFound;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var housingUnit = await Http.GetFromJsonAsync<HousingUnitDto>($"api/housingUnits/{Id}");

            if (housingUnit is null)
            {
                notFound = true;
                return;
            }

            model = new SaveHousingUnitDto
                {
                    Name = housingUnit.Name,
                    UnitType = housingUnit.UnitType,
                    Capacity = housingUnit.Capacity,
                    Occupied = housingUnit.Occupied,
                    LastCleanedAt = housingUnit.LastCleanedAt,
                    IsActive = housingUnit.IsActive,
                    ImageUrl = housingUnit.ImageUrl,
                    Note = housingUnit.Note
                };

            lastCleanedAt = housingUnit.LastCleanedAt;
        }
        catch (Exception ex)
        {
            errorMessage = $"Podatke nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateHousingUnit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            model.LastCleanedAt = lastCleanedAt;

            var response = await Http.PutAsJsonAsync($"api/housingUnits/{Id}", model);

            if(response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/housing-units");
                return;
            }

            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
