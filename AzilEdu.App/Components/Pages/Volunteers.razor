@page "/volunteers"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using AzilEdu.Shared.DTOs
@inject HttpClient Http
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Volonteri</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Volonteri dolaze iz baze preko API projekta. Status se čita iz povezane tablice VolunteerStatuses.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="searchString"
                          Label="Pretraži volontere"
                          Placeholder="Ime, prezime, email ili vještine"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Status"
                       @bind-Value="selectedStatus"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var status in statusList)
                {
                    <MudSelectItem Value="@status.Name">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetFilters">
                Očisti
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/volunteers/create" Class="mb-4">
    Novi volonter
</MudButton>

@if (isLoading)
{
    <MudPaper Class="pa-8 d-flex justify-center" Elevation="0">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudPaper>
}
else
{
<MudTable Items="@volunteers" Filter="FilterVolunteers" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<VolunteerDto, object>(x => x.LastName)">Prezime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<VolunteerDto, object>(x => x.FirstName)">Ime</MudTableSortLabel></MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Telefon</MudTh>
        <MudTh>Vještine</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<VolunteerDto, object>(x => x.AvailableFrom ?? DateTime.MaxValue)">Dostupan od</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<VolunteerDto, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
        <MudTh>Akcije</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Prezime">@context.LastName</MudTd>
        <MudTd DataLabel="Ime">@context.FirstName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Telefon">@context.Phone</MudTd>
        <MudTd DataLabel="Vještine">@context.Skills</MudTd>
        <MudTd DataLabel="Dostupan od">@GetAvailableFromText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetStatusColor(context.Status)"
                     Variant="Variant.Filled">
                @context.Status
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Akcije">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/volunteers/edit/{context.Id}")">
                Uredi
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteVolunteer(context))">
                Obriši
            </MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            @(volunteers.Count == 0
                ? "Još nema unesenih volontera."
                : "Nema rezultata za zadane kriterije pretrage i filtera.")
        </MudText>
    </NoRecordsContent>
</MudTable>
}

@code {
    private List<VolunteerDto> volunteers = new();
    private List<LookupDto> statusList = new();
    private bool isLoading = true;
    private string? errorMessage;

    private string searchString = string.Empty;
    private string? selectedStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadVolunteers();
    }

    private async Task LoadVolunteers()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            volunteers = await Http.GetFromJsonAsync<List<VolunteerDto>>("api/volunteers") ?? new();
            statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteerstatuses") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Volontere nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetFilters()
    {
        searchString = string.Empty;
        selectedStatus = null;
    }

    private bool FilterVolunteers(VolunteerDto volunteer)
    {
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var term = searchString.Trim().ToLower();

            var matchesSearch =
                (!string.IsNullOrWhiteSpace(volunteer.FirstName) && volunteer.FirstName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(volunteer.LastName) && volunteer.LastName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(volunteer.Email) && volunteer.Email.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(volunteer.Skills) && volunteer.Skills.ToLower().Contains(term));

            if (!matchesSearch)
                return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus) &&
            !string.Equals(volunteer.Status, selectedStatus, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private string GetAvailableFromText(VolunteerDto volunteer)
    {
        return volunteer.AvailableFrom.HasValue
            ? volunteer.AvailableFrom.Value.ToShortDateString()
            : "Nepoznato";
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Novi" => Color.Info,
            "Aktivan" => Color.Success,
            "Privremeno nedostupan" => Color.Warning,
            "Neaktivan" => Color.Default,
            _ => Color.Default
        };
    }

    private async Task DeleteVolunteer(VolunteerDto volunteer)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            title: "Brisanje volontera",
            message: $"Volonter \"{volunteer.FirstName} {volunteer.LastName}\" bit će trajno obrisan. Želiš li nastaviti?",
            yesText: "Obriši",
            cancelText: "Odustani");

        if (confirmed != true)
        {
            return;
        }

        errorMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"api/volunteers/{volunteer.Id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Volontera nije moguće obrisati.";
                return;
            }

            volunteers = volunteers.Where(v => v.Id != volunteer.Id).ToList();

            Snackbar.Add("Volonter je obrisan.", Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod brisanja volontera: {ex.Message}";
        }
    }
}
