@page "/volunteers/create"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Novi volonter</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici unosimo novog volontera i podatke šaljemo prema API-ju preko POST zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<EditForm Model="model" OnValidSubmit="SaveVolunteer" FormName="volunteer-create">
    <DataAnnotationsValidator />

    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.FirstName" Label="Ime" Required="true" Immediate="true"
                      For="@(() => model.FirstName)" />
        <MudTextField @bind-Value="model.LastName" Label="Prezime" Required="true" Immediate="true"
                      For="@(() => model.LastName)" />
        <MudTextField @bind-Value="model.Email" Label="Email" Immediate="true"
                      For="@(() => model.Email)" />
        <MudTextField @bind-Value="model.Phone" Label="Telefon" Immediate="true"
                      For="@(() => model.Phone)" />
        <MudTextField @bind-Value="model.Skills" Label="Vještine" Immediate="true"
                      For="@(() => model.Skills)" />
        <MudDatePicker @bind-Date="availableFrom" Label="Dostupan od" />

        <MudSelect T="int"
                   Label="Status"
                   @bind-Value="model.VolunteerStatusId"
                   Variant="Variant.Outlined"
                   Required="true"
                   For="@(() => model.VolunteerStatusId)">
            @foreach (var status in statusList)
            {
                <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="model.Notes" Label="Napomena" Lines="3" Immediate="true"
                      For="@(() => model.Notes)" />

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="isSaving">
            @(isSaving ? "Spremam..." : "Spremi")
        </MudButton>
    </MudStack>
</EditForm>

@code {
    private string? errorMessage;
    private bool isSaving;

    private List<LookupDto> statusList = new();
    private SaveVolunteerDto model = new();
    private DateTime? availableFrom = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteerstatuses") ?? new();

            if (model.VolunteerStatusId == 0 && statusList.Count > 0)
            {
                model.VolunteerStatusId = statusList[0].Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Statuse nije moguće učitati: {ex.Message}";
        }
    }

    private async Task SaveVolunteer()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            model.AvailableFrom = availableFrom;

            var response = await Http.PostAsJsonAsync("api/volunteers", model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/volunteers");
                return;
            }

            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
